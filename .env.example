# Настройки Django (замените на свои при запуске)
SECRET_KEY=django-insecure-insert-your-secret-key-here
DEBUG=True

# Настройки почтового сервера (понадобятся при переходе на реальный SMTP)
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=your_email@yandex.ru
EMAIL_HOST_PASSWORD=your_app_password
